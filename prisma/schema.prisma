generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  username         String?              @unique
  emailVerifiedAt  DateTime?
  password         String
  phoneNumber      String?
  avatar           String?
  roleId           String
  rememberToken    String?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  activityLogs     ActivityLog[]
  barangCategories BarangCategory[]
  barangs          Barang[]
  gudangs          Gudang[]
  jenisBarangs     JenisBarang[]
  notifications    Notification[]
  otpCodes         OtpCode[]
  passwordResets   PasswordResetToken[]
  satuans          Satuan[]
  sessions         Session[]
  transactions     Transaction[]
  role             Role                 @relation(fields: [roleId], references: [id])
  webSettings      WebSetting[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String?
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("otp_codes")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  isAllowed    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  module      String
  description String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model WebSetting {
  id           String    @id @default(cuid())
  webNama      String
  webLogo      String?
  webDeskripsi String?
  userId       String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])

  @@map("web_settings")
}

model BarangCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  userId    String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  barangs   Barang[]

  @@map("barang_categories")
}

model JenisBarang {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  userId      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barangs     Barang[]
  user        User      @relation(fields: [userId], references: [id])

  @@map("jenis_barangs")
}

model Satuan {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  userId      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barangs     Barang[]
  user        User      @relation(fields: [userId], references: [id])

  @@map("satuans")
}

model Gudang {
  id                 String              @id @default(cuid())
  name               String              @unique
  slug               String              @unique
  description        String?
  userId             String
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  barangGudangs      BarangGudang[]
  user               User                @relation(fields: [userId], references: [id])
  transactionDetails TransactionDetail[]

  @@map("gudangs")
}

model Barang {
  id                 String              @id @default(cuid())
  barangKode         String              @unique
  barangNama         String              @unique
  barangSlug         String              @unique
  barangHarga        Decimal             @db.Decimal(15, 2)
  barangGambar       String?
  stokMinimum        Int                 @default(0)
  jenisBarangId      String
  satuanId           String
  barangCategoryId   String
  userId             String
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isActive           Boolean             @default(true)
  barangGudangs      BarangGudang[]
  barangCategory     BarangCategory      @relation(fields: [barangCategoryId], references: [id])
  jenisBarang        JenisBarang         @relation(fields: [jenisBarangId], references: [id])
  satuan             Satuan              @relation(fields: [satuanId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  transactionDetails TransactionDetail[]

  @@map("barangs")
}

model BarangGudang {
  barangId        String
  gudangId        String
  stokTersedia    Int       @default(0)
  stokDipinjam    Int       @default(0)
  stokMaintenance Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  barang          Barang    @relation(fields: [barangId], references: [id])
  gudang          Gudang    @relation(fields: [gudangId], references: [id])

  @@id([barangId, gudangId])
  @@map("barang_gudangs")
}

model TransactionType {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                String              @id @default(cuid())
  transactionCode   String              @unique
  transactionDate   DateTime
  description       String?
  status            TransactionStatus   @default(ACTIVE)
  userId            String
  transactionTypeId String
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  details           TransactionDetail[]
  transactionType   TransactionType     @relation(fields: [transactionTypeId], references: [id])
  user              User                @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model TransactionDetail {
  id             String      @id @default(cuid())
  transactionId  String
  barangId       String
  gudangId       String
  quantity       Int
  tanggalKembali DateTime?
  kondisiKembali String?
  catatan        String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  barang         Barang      @relation(fields: [barangId], references: [id])
  gudang         Gudang      @relation(fields: [gudangId], references: [id])
  transaction    Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_details")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum OtpType {
  EMAIL_VERIFICATION
  TWO_FACTOR
  SENSITIVE_ACTION
}

enum TransactionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  STOK_MINIMUM
  PEMINJAMAN_TERLAMBAT
  BARANG_MASUK
  MAINTENANCE
  SYSTEM
}
